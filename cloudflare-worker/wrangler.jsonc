{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-proxy-subscription",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "sub.example.com",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SUBSCRIPTIONS",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
